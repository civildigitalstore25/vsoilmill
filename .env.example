# VS OilMill Environment Example

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=918438775451

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/vsoilmill

# NextAuth
AUTH_SECRET=dev-secret-change-in-production
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ==============================================================================
# PhonePe Payment Gateway
# ==============================================================================
# Active Environment Switch:
# Set to 'SANDBOX' for local development & testing with test/sample keys
# Set to 'PRODUCTION' when going live with real merchant credentials
PHONEPE_ENV=SANDBOX

# --- Development / Test (Sandbox) Credentials ---
# Standard PhonePe UAT sample test keys are pre-filled below:
PHONEPE_TEST_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_TEST_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_TEST_SALT_INDEX=1
# Optional: Webhook Basic Auth (if configured on PhonePe Test Dashboard)
PHONEPE_TEST_CALLBACK_USERNAME=
PHONEPE_TEST_CALLBACK_PASSWORD=

# --- Production / Live Credentials (from PhonePe Merchant Dashboard) ---
# Fill these in when switching to production (PHONEPE_ENV=PRODUCTION):
PHONEPE_PROD_MERCHANT_ID=
PHONEPE_PROD_SALT_KEY=
PHONEPE_PROD_SALT_INDEX=1
# Optional: Webhook Basic Auth (if configured on PhonePe Production Dashboard)
PHONEPE_PROD_CALLBACK_USERNAME=
PHONEPE_PROD_CALLBACK_PASSWORD=

# Admin seed
ADMIN_EMAIL=admin@vsoilmill.com
ADMIN_PASSWORD=Admin@12345
